# Base de données Neon (Postgres serverless)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generer-avec: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Seam paiement (non implémenté pour le MVP, réservé pour Stripe/autre plus tard)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# PricePilot AI (assistant /assistant) — optionnel : sans cette clé, le reste de
# l'application fonctionne normalement, seul /assistant renvoie une erreur claire.
# Clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# Recherche web — facultatif. Sans aucune clé, PricePilot utilise DuckDuckGo
# (gratuit, sans inscription, mais susceptible d'être limité en débit).
# Pour un service plus stable, renseigner UNE de ces options, toutes gratuites :
#   Tavily — 1000 recherches/mois offertes : https://tavily.com
# TAVILY_API_KEY=
#   Google Programmable Search — 100 recherches/jour offertes :
#   https://developers.google.com/custom-search/v1/overview
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
